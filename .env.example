# Telegram
BOT_TOKEN=123456:replace_me
GROUP_CHAT_ID=-1000000000000
PERSONAL_CHAT_ID=123456789

# HDE
HDE_WEBHOOK_SECRET=replace_with_random_secret
HDE_OWNER_ID=12345
HDE_OWNER_NAME=Your Name
HDE_API_BASE_URL=https://your-company.helpdeskeddy.com/api/v2
HDE_API_EMAIL=bot@example.com
HDE_API_KEY=replace_with_api_key

# Server
WEBHOOK_HOST=https://your-domain.com
NGROK_STATIC_URL=https://your-static-domain.ngrok-free.dev
WEBHOOK_PATH_TG=/webhook/telegram
WEBHOOK_PATH_HDE=/webhook/hde
APP_PORT=8080

# Bot timers
DEFAULT_REPLY_SLA_MINUTES=30
PRE_SLA_WARNING_MINUTES=10
SCHEDULER_INTERVAL_SECONDS=30

# Operator reply workflow
OPERATOR_TELEGRAM_USER_IDS=123456789
HDE_PUBLIC_REPLY_ENABLED=false
HDE_PUBLIC_REPLY_TICKET_ALLOWLIST=

# Daily operator report -> Google Sheets
# Password for HDE web UI login (if not set, HDE_API_KEY is used as fallback)
HDE_REPORT_PASSWORD=replace_with_hde_web_password

# Google service account JSON key file.
# Create a service account in Google Cloud, enable Google Sheets API,
# download the JSON key and share the spreadsheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google_service_account.json

# Backward-compatible legacy alias. Leave empty unless you still use the old name.
GOOGLE_CREDENTIALS_FILE=

# ID from the Google Sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SPREADSHEET_ID=replace_with_spreadsheet_id

# Tab name at the bottom of the spreadsheet
GOOGLE_WORKSHEET_NAME=Ввод данных_2026

# Value written to column A
GOOGLE_SHEET_NAME_IN_A=Кравцов Игорь

# UTC hour for automatic daily report (default: 6 = 9:00 Moscow)
REPORT_SEND_HOUR_UTC=6

# General topic notifications (unassigned tickets)
# Set GENERAL_TOPIC_ID to the message_thread_id of the General topic to enable this feature
GENERAL_TOPIC_ID=
# Optional: only notify for tickets in this department (leave empty for all departments)
UNASSIGNED_DEPARTMENT=Оборудование
