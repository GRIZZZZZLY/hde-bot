# Telegram
BOT_TOKEN=123456:replace_me
GROUP_CHAT_ID=-1000000000000
PERSONAL_CHAT_ID=123456789

# HDE
HDE_WEBHOOK_SECRET=replace_with_random_secret
HDE_OWNER_ID=12345
HDE_OWNER_NAME=Your Name
HDE_API_BASE_URL=https://your-company.helpdeskeddy.com/api/v2
HDE_API_EMAIL=bot@example.com
HDE_API_KEY=replace_with_api_key

# Server
WEBHOOK_HOST=https://your-domain.com
NGROK_STATIC_URL=https://your-static-domain.ngrok-free.dev
WEBHOOK_PATH_TG=/webhook/telegram
WEBHOOK_PATH_HDE=/webhook/hde
APP_PORT=8080

# Bot timers
DEFAULT_REPLY_SLA_MINUTES=30
PRE_SLA_WARNING_MINUTES=10
SCHEDULER_INTERVAL_SECONDS=30

# Operator reply workflow
OPERATOR_TELEGRAM_USER_IDS=123456789
HDE_PUBLIC_REPLY_ENABLED=false
HDE_PUBLIC_REPLY_TICKET_ALLOWLIST=

# Daily operator report -> Google Sheets
# Password for HDE web UI login (if not set, HDE_API_KEY is used as fallback)
HDE_REPORT_PASSWORD=replace_with_hde_web_password

# Google service account JSON key file.
# Create a service account in Google Cloud, enable Google Sheets API,
# download the JSON key and share the spreadsheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google_service_account.json

# Backward-compatible legacy alias. Leave empty unless you still use the old name.
GOOGLE_CREDENTIALS_FILE=

# ID from the Google Sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SPREADSHEET_ID=replace_with_spreadsheet_id

# Tab name at the bottom of the spreadsheet
GOOGLE_WORKSHEET_NAME=Ввод данных_2026

# Value written to column A
GOOGLE_SHEET_NAME_IN_A=Кравцов Игорь

# UTC hour for automatic daily report (default: 6 = 9:00 Moscow)
REPORT_SEND_HOUR_UTC=6

# Work schedule — bot is silent outside these hours
# WORK_DAYS: comma-separated Python weekday numbers (0=Mon, 1=Tue, ..., 6=Sun)
# Default 0,1,2,3,6 = Mon–Thu + Sun
WORK_DAYS=0,1,2,3,6
# Hours in Europe/Moscow timezone (inclusive start, exclusive end)
WORK_HOUR_START=9
WORK_HOUR_END=18

# AI Summary — Groq API key (primary LLM provider)
# Get a free key at https://console.groq.com/keys
# If not set, AI summaries are disabled.
GROQ_API_KEY=

# OpenRouter — last-resort fallback for /aianalyze and prompt mutations (optional)
OPENROUTER_API_KEY=

# Deepgram transcription — audio messages from clients (optional)
# Get a free key at https://console.deepgram.com
# If not set, audio attachments are skipped in AI summaries.
DEEPGRAM_API_KEY=

# Pre-SLA safety net
PRESLA_HDE_VERIFY=1           # 1 = verify with HDE before firing alert; 0 = skip check
REASSURANCE_MINUTES_BEFORE=2  # auto-reply to client this many minutes before SLA deadline
REASSURANCE_TEXT=Я про вас не забыл, занимаюсь вашим вопросом 🔧

# General topic notifications (unassigned tickets)
# message_thread_id of the General topic (default: 1, which is always the General branch in Telegram)
GENERAL_TOPIC_ID=1
# Optional: only notify for tickets in this department (leave empty for all departments)
UNASSIGNED_DEPARTMENT=Оборудование

# Контекст агента и автоматизация базы знаний (2026-09-07)
# Голосовая заметка оператора после звонка → контекст тикета (call_notes).
# Читают её черновик агента и ночная сверка; в общую базу знаний она не идёт.
AGENT_CALL_FIXATION_ENABLED=0
# Пересборка черновика, когда коллега дописал внутренний комментарий.
# Тратит токены Groq: на free-tier TPM это заметно, лимит — 3 тикета за проход.
AGENT_DRAFT_REFRESH_ENABLED=0

# Шум в Telegram (2026-09-15). Все четыре по умолчанию выключены: оператору
# нужны новые ответы клиента, остальное он видит в HDE. Значение 1 возвращает
# сообщения обратно, рестарт — и всё как было.
# Дамп всей переписки тикета в топик при его создании.
TICKET_HISTORY_POST_ENABLED=0
# Утренний дайджест в группу («неразобранного оборудования: N»).
MORNING_DIGEST_ENABLED=0
# Автоматические Суть / Ответ клиенту / Памятка. Кнопка 💡 работает всегда.
AI_SUGGESTION_AUTO_ENABLED=0
# Автоклассификация поля «Окружение» в HDE (выключена: ставила неверные
# значения и затирала ручные). Классификация/Роль/Приоритет/Тип не зависят.
ENV_AUTOFILL_ENABLED=0
# Сводки в личный чат: польза AI-подсказок, итоги ночной сверки, противоречия
# базы знаний с кнопками. Аварийные алерты этим флагом НЕ гасятся.
PERSONAL_DIGESTS_ENABLED=0
# Ночная сверка 02:00 (предложения бота против ответов оператора). Вместе с ней
# останавливается разбор кандидатов в базу знаний и архивация старых правил.
NIGHTLY_RECONCILE_ENABLED=0

# Агент черновиков v2: промпт по регламенту «Лояльная техподдержка»
AGENT_VOICE_V2_ENABLED=0
# Черновик на каждый ответ клиента (нужен AGENT_VOICE_V2_ENABLED=1)
AGENT_REPLY_DRAFTS_ENABLED=0
# Пополнять базу знаний по итогам ночной сверки
RECONCILE_KB_DISTILL_ENABLED=0
# Другой OpenAI-совместимый провайдер только для черновиков v2 (пусто — Groq)
AGENT_V2_LLM_BASE_URL=
AGENT_V2_LLM_API_KEY=
AGENT_V2_LLM_MODEL=
